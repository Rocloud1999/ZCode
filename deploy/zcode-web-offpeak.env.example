# Copy outside the repository to /etc/zcode-web-offpeak.env, readable only by root/zcode.
# Do not commit the real file, a JWT, API Key, or real access token.
ZCODE_WEB_OFFPEAK_ENABLED=1
ZCODE_DATA_BASE_DIR=/var/lib/zcode-web-offpeak
ZCODE_SERVER_WORKSPACE=/srv/projects/my-project
ZCODE_SERVER_HOST=127.0.0.1
PORT=3030
ZCODE_WEB_STATIC_ROOT=/opt/ZCode/packages/web/dist
ZCODE_AGENT_SERVER_COMMAND=/usr/bin/node
ZCODE_AGENT_SERVER_ARGS_JSON='["/opt/ZCode/apps/zcode-cli/packages/cli/dist/zcode.cjs","app-server","--stdio"]'
# Replace the following placeholder locally with a random token of >=32 characters.
ZCODE_SERVER_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_TOKEN
